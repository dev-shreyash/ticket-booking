generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

enum MovieStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SeatCategory {
  STANDARD
  PREMIUM
  RECLINER
}

enum SeatType {
  STANDARD
  PREMIUM
  RECLINER
}

enum ShowStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ShowSeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum SeatHoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  CASH_AT_THEATRE
}

// ============================================================
// USERS AND AUTHENTICATION
// ============================================================

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?
  email     String?  @unique @db.VarChar(320)
  phone     String?  @unique @db.VarChar(16)
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  sessions           Session[]
  seatHolds          SeatHold[]
  bookings           Booking[]
  idempotencyRecords IdempotencyRecord[]

  @@index([role])
}

model OtpVerification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier   String    @db.VarChar(320)
  codeHash     String    @db.VarChar(255)
  expiresAt    DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([identifier, createdAt])
  @@index([identifier, expiresAt])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// ============================================================
// MOVIES
// ============================================================

model Movie {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String      @db.VarChar(200)
  description   String      @db.Text
  duration      Int
  language      String      @db.VarChar(80)
  genre         String      @db.VarChar(120)
  certification String      @db.VarChar(20)
  posterUrl     String?     @db.Text
  releaseDate   DateTime    @db.Date
  status        MovieStatus @default(DRAFT)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  shows Show[]

  @@index([status, releaseDate])
  @@index([title])
}

// ============================================================
// THEATRES AND SCREENS
// ============================================================

model Theatre {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  address   String   @db.Text
  city      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  screens Screen[]

  @@index([city])
}

model Screen {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  theatreId String   @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  theatre  Theatre       @relation(fields: [theatreId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sections SeatSection[]
  shows    Show[]

  @@unique([theatreId, name])
  @@index([theatreId])
}

// ============================================================
// SEAT SECTIONS
// ============================================================

model SeatSection {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  screenId  String       @db.Uuid
  name      String       @db.VarChar(100)
  category  SeatCategory
  basePrice Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  screen     Screen             @relation(fields: [screenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seats      Seat[]
  showPrices ShowSectionPrice[]

  @@unique([screenId, name])
  @@unique([id, screenId])
  @@index([screenId])
}

// ============================================================
// SHOW-SPECIFIC SECTION PRICING
// ============================================================

model ShowSectionPrice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showId    String   @db.Uuid
  screenId  String   @db.Uuid
  sectionId String   @db.Uuid
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  show    Show        @relation(fields: [showId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  section SeatSection @relation(fields: [sectionId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([showId, sectionId])
  @@index([sectionId, screenId])
  @@index([showId, screenId])
}

// ============================================================
// PHYSICAL SEATS
// ============================================================

model Seat {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  screenId   String   @db.Uuid
  sectionId  String   @db.Uuid
  rowLabel   String   @db.VarChar(10)
  seatNumber Int
  seatType   SeatType
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  section      SeatSection   @relation(fields: [sectionId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  showSeats    ShowSeat[]
  bookingSeats BookingSeat[]

  @@unique([sectionId, rowLabel, seatNumber])
  @@unique([id, screenId])
  @@index([screenId, rowLabel])
  @@index([sectionId])
}

// ============================================================
// SHOWS
// ============================================================

model Show {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movieId   String     @db.Uuid
  screenId  String     @db.Uuid
  startTime DateTime   @db.Timestamptz(3)
  endTime   DateTime   @db.Timestamptz(3)
  status    ShowStatus @default(SCHEDULED)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  movie        Movie         @relation(fields: [movieId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  screen       Screen        @relation(fields: [screenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  showSeats    ShowSeat[]
  seatHolds    SeatHold[]
  bookings     Booking[]
  bookingSeats BookingSeat[]

  // Required reverse relation for ShowSectionPrice.
  sectionPrices ShowSectionPrice[]

  @@unique([id, screenId])
  @@index([movieId, startTime, status])
  @@index([screenId, startTime, status])
  @@index([status, startTime])
}

// ============================================================
// TEMPORARY SEAT HOLDS
// ============================================================

model SeatHold {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @db.Uuid
  showId    String         @db.Uuid
  status    SeatHoldStatus @default(ACTIVE)
  expiresAt DateTime       @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  show      Show       @relation(fields: [showId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  showSeats ShowSeat[] @relation("HoldInventory")

  @@unique([id, showId])
  @@index([userId, status])
  @@index([showId, status])
  @@index([status, expiresAt])
  @@index([expiresAt])
}

// ============================================================
// BOOKINGS
// ============================================================

model Booking {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingReference String        @unique @db.VarChar(40)
  userId           String        @db.Uuid
  showId           String        @db.Uuid
  screenId         String        @db.Uuid
  status           BookingStatus @default(CONFIRMED)
  totalAmount      Decimal       @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod @default(CASH_AT_THEATRE)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  show              Show               @relation(fields: [showId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  showSeats         ShowSeat[]         @relation("SeatAllocations")
  bookingSeats      BookingSeat[]      @relation("BookingTickets")
  idempotencyRecord IdempotencyRecord?

  @@unique([id, showId])
  @@unique([id, userId, bookingReference])
  @@index([userId, createdAt])
  @@index([showId, status])
  @@index([paymentStatus, createdAt])
}

// ============================================================
// SHOW-SPECIFIC SEAT INVENTORY
// ============================================================

model ShowSeat {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showId    String         @db.Uuid
  screenId  String         @db.Uuid
  seatId    String         @db.Uuid
  status    ShowSeatStatus @default(AVAILABLE)
  holdId    String?        @db.Uuid
  bookingId String?        @db.Uuid
  expiresAt DateTime?      @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  show        Show         @relation(fields: [showId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  seat        Seat         @relation(fields: [seatId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  hold        SeatHold?    @relation("HoldInventory", fields: [holdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  booking     Booking?     @relation("SeatAllocations", fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookingSeat BookingSeat? @relation("TicketInventory")

  @@unique([showId, seatId])
  @@unique([bookingId, showId, seatId])
  @@index([showId, status])
  @@index([holdId])
  @@index([bookingId])
  @@index([expiresAt])
  @@index([screenId])
  @@index([seatId, screenId])
}

// ============================================================
// HISTORICAL BOOKING SEATS
// ============================================================

model BookingSeat {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String   @db.Uuid
  showId            String   @db.Uuid
  screenId          String   @db.Uuid
  seatId            String   @db.Uuid
  seatLabelSnapshot String   @db.VarChar(40)
  sectionSnapshot   String   @db.VarChar(100)
  seatTypeSnapshot  String   @default("STANDARD")
  price             Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  booking   Booking  @relation("BookingTickets", fields: [bookingId, showId], references: [id, showId], onDelete: Restrict, onUpdate: Cascade)
  show      Show     @relation(fields: [showId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  seat      Seat     @relation(fields: [seatId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  inventory ShowSeat @relation("TicketInventory", fields: [showId, seatId], references: [showId, seatId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([showId, seatId])
  @@unique([bookingId, showId, seatId])
  @@index([bookingId])
  @@index([showId])
  @@index([seatId, screenId])
}

// ============================================================
// IDEMPOTENCY
// ============================================================

model IdempotencyRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @db.Uuid
  idempotencyKey     String   @db.VarChar(255)
  requestFingerprint String   @db.VarChar(64)
  bookingId          String?  @unique @db.Uuid
  bookingReference   String?  @db.VarChar(40)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}
