<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  CUSTOMER
  ADMIN
}

enum MovieStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SeatCategory {
  STANDARD
  PREMIUM
  RECLINER
}

enum SeatType {
  STANDARD
  PREMIUM
  RECLINER
}

enum ShowStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ShowSeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum SeatHoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  CASH_AT_THEATRE
}

enum UserDocumentType {
  PROFILE_PHOTO
  ID_CARD
}
// ============================================================
// USERS AND AUTHENTICATION
// ============================================================

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?
  email     String?  @unique @db.VarChar(320)
  phone     String?  @unique @db.VarChar(16)
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  sessions           Session[]
  seatHolds          SeatHold[]
  bookings           Booking[]
  idempotencyRecords IdempotencyRecord[]
  documents UserDocument[]

  @@index([role])
}

model OtpVerification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier   String    @db.VarChar(320)
  codeHash     String    @db.VarChar(255)
  expiresAt    DateTime  @db.Timestamptz(3)
  consumedAt   DateTime? @db.Timestamptz(3)
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([identifier, createdAt])
  @@index([identifier, expiresAt])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// ============================================================
// MOVIES
// ============================================================

model Movie {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String      @db.VarChar(200)
  description   String      @db.Text
  duration      Int
  language      String      @db.VarChar(80)
  genre         String      @db.VarChar(120)
  certification String      @db.VarChar(20)
  posterUrl     String?     @db.Text
  releaseDate   DateTime    @db.Date
  status        MovieStatus @default(DRAFT)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @default(now()) @updatedAt @db.Timestamptz(3)

  shows Show[]

  @@index([status, releaseDate])
  @@index([title])
}

// ============================================================
// THEATRES AND SCREENS
// ============================================================

model Theatre {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  address   String   @db.Text
  city      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  screens Screen[]

  @@index([city])
}

model Screen {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  theatreId String   @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  theatre  Theatre       @relation(fields: [theatreId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sections SeatSection[]
  shows    Show[]

  @@unique([theatreId, name])
  @@index([theatreId])
}

// ============================================================
// SEAT SECTIONS
// ============================================================

model SeatSection {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  screenId  String       @db.Uuid
  name      String       @db.VarChar(100)
  category  SeatCategory
  basePrice Decimal      @db.Decimal(10, 2)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  screen     Screen             @relation(fields: [screenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  seats      Seat[]
  showPrices ShowSectionPrice[]

  @@unique([screenId, name])
  @@unique([id, screenId])
  @@index([screenId])
}

// ============================================================
// SHOW-SPECIFIC SECTION PRICING
// ============================================================

model ShowSectionPrice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showId    String   @db.Uuid
  screenId  String   @db.Uuid
  sectionId String   @db.Uuid
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  show    Show        @relation(fields: [showId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  section SeatSection @relation(fields: [sectionId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([showId, sectionId])
  @@index([sectionId, screenId])
  @@index([showId, screenId])
}

// ============================================================
// PHYSICAL SEATS
// ============================================================

model Seat {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  screenId   String   @db.Uuid
  sectionId  String   @db.Uuid
  rowLabel   String   @db.VarChar(10)
  seatNumber Int
  seatType   SeatType
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  section      SeatSection   @relation(fields: [sectionId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  showSeats    ShowSeat[]
  bookingSeats BookingSeat[]

  @@unique([sectionId, rowLabel, seatNumber])
  @@unique([id, screenId])
  @@index([screenId, rowLabel])
  @@index([sectionId])
}

// ============================================================
// SHOWS
// ============================================================

model Show {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  movieId   String     @db.Uuid
  screenId  String     @db.Uuid
  startTime DateTime   @db.Timestamptz(3)
  endTime   DateTime   @db.Timestamptz(3)
  status    ShowStatus @default(SCHEDULED)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @default(now()) @updatedAt @db.Timestamptz(3)

  movie        Movie         @relation(fields: [movieId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  screen       Screen        @relation(fields: [screenId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  showSeats    ShowSeat[]
  seatHolds    SeatHold[]
  bookings     Booking[]
  bookingSeats BookingSeat[]

  // Required reverse relation for ShowSectionPrice.
  sectionPrices ShowSectionPrice[]

  @@unique([id, screenId])
  @@index([movieId, startTime, status])
  @@index([screenId, startTime, status])
  @@index([status, startTime])
}

// ============================================================
// TEMPORARY SEAT HOLDS
// ============================================================

model SeatHold {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @db.Uuid
  showId    String         @db.Uuid
  status    SeatHoldStatus @default(ACTIVE)
  expiresAt DateTime       @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  show      Show       @relation(fields: [showId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  showSeats ShowSeat[] @relation("HoldInventory")

  @@unique([id, showId])
  @@index([userId, status])
  @@index([showId, status])
  @@index([status, expiresAt])
  @@index([expiresAt])
}

// ============================================================
// BOOKINGS
// ============================================================

model Booking {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingReference String        @unique @db.VarChar(40)
  userId           String        @db.Uuid
  showId           String        @db.Uuid
  screenId         String        @db.Uuid
  status           BookingStatus @default(CONFIRMED)
  totalAmount      Decimal       @db.Decimal(10, 2)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    PaymentMethod @default(CASH_AT_THEATRE)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  show              Show               @relation(fields: [showId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  showSeats         ShowSeat[]         @relation("SeatAllocations")
  bookingSeats      BookingSeat[]      @relation("BookingTickets")
  idempotencyRecord IdempotencyRecord?

  @@unique([id, showId])
  @@unique([id, userId, bookingReference])
  @@index([userId, createdAt])
  @@index([showId, status])
  @@index([paymentStatus, createdAt])
}

// ============================================================
// SHOW-SPECIFIC SEAT INVENTORY
// ============================================================

model ShowSeat {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showId    String         @db.Uuid
  screenId  String         @db.Uuid
  seatId    String         @db.Uuid
  status    ShowSeatStatus @default(AVAILABLE)
  holdId    String?        @db.Uuid
  bookingId String?        @db.Uuid
  expiresAt DateTime?      @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  show        Show         @relation(fields: [showId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  seat        Seat         @relation(fields: [seatId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  hold        SeatHold?    @relation("HoldInventory", fields: [holdId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  booking     Booking?     @relation("SeatAllocations", fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookingSeat BookingSeat? @relation("TicketInventory")

  @@unique([showId, seatId])
  @@unique([bookingId, showId, seatId])
  @@index([showId, status])
  @@index([holdId])
  @@index([bookingId])
  @@index([expiresAt])
  @@index([screenId])
  @@index([seatId, screenId])
}

// ============================================================
// HISTORICAL BOOKING SEATS
// ============================================================

model BookingSeat {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String   @db.Uuid
  showId            String   @db.Uuid
  screenId          String   @db.Uuid
  seatId            String   @db.Uuid
  seatLabelSnapshot String   @db.VarChar(40)
  sectionSnapshot   String   @db.VarChar(100)
  seatTypeSnapshot  String   @default("STANDARD")
  price             Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  booking   Booking  @relation("BookingTickets", fields: [bookingId, showId], references: [id, showId], onDelete: Restrict, onUpdate: Cascade)
  show      Show     @relation(fields: [showId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  seat      Seat     @relation(fields: [seatId, screenId], references: [id, screenId], onDelete: Restrict, onUpdate: Cascade)
  inventory ShowSeat @relation("TicketInventory", fields: [showId, seatId], references: [showId, seatId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([showId, seatId])
  @@unique([bookingId, showId, seatId])
  @@index([bookingId])
  @@index([showId])
  @@index([seatId, screenId])
}

// ============================================================
// IDEMPOTENCY
// ============================================================

model IdempotencyRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @db.Uuid
  idempotencyKey     String   @db.VarChar(255)
  requestFingerprint String   @db.VarChar(64)
  bookingId          String?  @unique @db.Uuid
  bookingReference   String?  @db.VarChar(40)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}
model UserDocument {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @db.Uuid
  type        UserDocumentType
  objectKey   String           @unique @db.VarChar(500)
  fileName    String           @db.VarChar(255)
  contentType String           @db.VarChar(100)
  fileSize    Int
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}
</file>

<file path="prisma/seed.ts">
import "dotenv/config";

import { PrismaPg } from "@prisma/adapter-pg";

import {
  MovieStatus,
  PrismaClient,
  SeatCategory,
  SeatType,
  ShowSeatStatus,
  ShowStatus,
  UserRole,
} from "../src/generated/prisma/client";

import { getServerEnvironment } from "../src/lib/env";

const { DATABASE_URL } = getServerEnvironment();

const prisma = new PrismaClient({
  adapter: new PrismaPg({
    connectionString: DATABASE_URL,
  }),
});

function deterministicUuid(value: number): string {
  return `00000000-0000-4000-8000-${value
    .toString(16)
    .padStart(12, "0")}`;
}

function utcDateInDays(
  daysFromToday: number,
  hour: number,
  minute = 0,
): Date {
  const date = new Date();

  date.setUTCHours(0, 0, 0, 0);
  date.setUTCDate(date.getUTCDate() + daysFromToday);
  date.setUTCHours(hour, minute, 0, 0);

  return date;
}

function addMinutes(date: Date, minutes: number): Date {
  return new Date(date.getTime() + minutes * 60_000);
}

async function seedUsers() {
  await prisma.user.upsert({
    where: {
      id: deterministicUuid(1),
    },
    create: {
      id: deterministicUuid(1),
      name: "Development Admin",
      email: "admin@example.test",
      role: UserRole.ADMIN,
    },
    update: {},
  });

  await prisma.user.upsert({
    where: {
      id: deterministicUuid(2),
    },
    create: {
      id: deterministicUuid(2),
      name: "Development Customer",
      email: "customer@example.test",
      role: UserRole.CUSTOMER,
    },
    update: {},
  });
}

async function seedCatalogue() {
  const movies = [
    {
      id: deterministicUuid(101),
      title: "Orbit: Beyond the Stars",
      description:
        "A science-fiction expedition discovers an unexpected signal beyond the solar system.",
      duration: 142,
      language: "English",
      genre: "Science Fiction / Adventure",
      certification: "UA 13+",
      releaseDate: new Date("2026-10-15T00:00:00.000Z"),
    },
    {
      id: deterministicUuid(102),
      title: "The Last Monsoon",
      description:
        "A family returns to its coastal hometown as an extraordinary monsoon changes their lives.",
      duration: 128,
      language: "Hindi",
      genre: "Drama",
      certification: "UA 13+",
      releaseDate: new Date("2026-10-22T00:00:00.000Z"),
    },
    {
      id: deterministicUuid(103),
      title: "Code Red",
      description:
        "A cybersecurity analyst races to stop a city-wide infrastructure attack.",
      duration: 116,
      language: "English",
      genre: "Thriller",
      certification: "UA 16+",
      releaseDate: new Date("2026-10-29T00:00:00.000Z"),
    },
  ];

  for (const movie of movies) {
    await prisma.movie.upsert({
      where: {
        id: movie.id,
      },
      create: {
        ...movie,
        status: MovieStatus.ACTIVE,
      },
      update: {},
    });
  }

  const theatres = [
    {
      id: deterministicUuid(201),
      name: "CineSquare Thane",
      address: "Eastern Express Highway, Thane, Maharashtra",
      city: "Thane",
    },
    {
      id: deterministicUuid(202),
      name: "MetroPoint Dombivli",
      address: "Manpada Road, Dombivli, Maharashtra",
      city: "Dombivli",
    },
  ];

  for (const theatre of theatres) {
    await prisma.theatre.upsert({
      where: {
        id: theatre.id,
      },
      create: theatre,
      update: {},
    });
  }

  const screens = [
    {
      id: deterministicUuid(301),
      theatreId: deterministicUuid(201),
      name: "Screen 1",
    },
    {
      id: deterministicUuid(302),
      theatreId: deterministicUuid(202),
      name: "Screen 1",
    },
  ];

  for (const screen of screens) {
    await prisma.screen.upsert({
      where: {
        id: screen.id,
      },
      create: screen,
      update: {},
    });
  }

  const sections = [
    {
      id: deterministicUuid(401),
      screenId: deterministicUuid(301),
      name: "Silver",
      category: SeatCategory.STANDARD,
      basePrice: "180.00",
      seatType: SeatType.STANDARD,
      rows: ["A", "B"],
      seatsPerRow: 8,
    },
    {
      id: deterministicUuid(402),
      screenId: deterministicUuid(301),
      name: "Gold",
      category: SeatCategory.PREMIUM,
      basePrice: "260.00",
      seatType: SeatType.PREMIUM,
      rows: ["C"],
      seatsPerRow: 6,
    },
    {
      id: deterministicUuid(403),
      screenId: deterministicUuid(302),
      name: "Silver",
      category: SeatCategory.STANDARD,
      basePrice: "180.00",
      seatType: SeatType.STANDARD,
      rows: ["A", "B"],
      seatsPerRow: 8,
    },
    {
      id: deterministicUuid(404),
      screenId: deterministicUuid(302),
      name: "Gold",
      category: SeatCategory.PREMIUM,
      basePrice: "260.00",
      seatType: SeatType.PREMIUM,
      rows: ["C"],
      seatsPerRow: 6,
    },
  ];

  let seatSequence = 1;

  for (const section of sections) {
    await prisma.seatSection.upsert({
      where: {
        id: section.id,
      },
      create: {
        id: section.id,
        screenId: section.screenId,
        name: section.name,
        category: section.category,
        basePrice: section.basePrice,
      },
      update: {},
    });

    for (const rowLabel of section.rows) {
      for (
        let seatNumber = 1;
        seatNumber <= section.seatsPerRow;
        seatNumber += 1
      ) {
        const seatId = deterministicUuid(
          5000 + seatSequence,
        );

        seatSequence += 1;

        await prisma.seat.upsert({
          where: {
            id: seatId,
          },
          create: {
            id: seatId,
            screenId: section.screenId,
            sectionId: section.id,
            rowLabel,
            seatNumber,
            seatType: section.seatType,
          },
          update: {},
        });
      }
    }
  }
}

async function seedShowsAndInventory() {
  const showDefinitions = [
    {
      id: deterministicUuid(601),
      movieId: deterministicUuid(101),
      screenId: deterministicUuid(301),
      startTime: utcDateInDays(1, 10, 0),
      duration: 142,
    },
    {
      id: deterministicUuid(602),
      movieId: deterministicUuid(102),
      screenId: deterministicUuid(301),
      startTime: utcDateInDays(1, 14, 0),
      duration: 128,
    },
    {
      id: deterministicUuid(603),
      movieId: deterministicUuid(103),
      screenId: deterministicUuid(302),
      startTime: utcDateInDays(1, 18, 30),
      duration: 116,
    },
    {
      id: deterministicUuid(604),
      movieId: deterministicUuid(101),
      screenId: deterministicUuid(302),
      startTime: utcDateInDays(2, 11, 0),
      duration: 142,
    },
  ];

  for (const definition of showDefinitions) {
    await prisma.$transaction(async (tx) => {
      const show = await tx.show.upsert({
        where: {
          id: definition.id,
        },
        create: {
          id: definition.id,
          movieId: definition.movieId,
          screenId: definition.screenId,
          startTime: definition.startTime,
          endTime: addMinutes(
            definition.startTime,
            definition.duration + 20,
          ),
          status: ShowStatus.SCHEDULED,
        },
        update: {},
        select: {
          id: true,
          screenId: true,
        },
      });

      const sections = await tx.seatSection.findMany({
        where: {
          screenId: show.screenId,
        },
        select: {
          id: true,
          basePrice: true,
        },
        orderBy: {
          id: "asc",
        },
      });

      const showSequence = Number.parseInt(
        show.id.slice(-4),
        16,
      );

      // Create show-specific prices using the section base price.
      // Existing show prices are deliberately never overwritten.
      await tx.showSectionPrice.createMany({
        data: sections.map((section, index) => ({
          id: deterministicUuid(
            20_000 + showSequence * 10 + index,
          ),
          showId: show.id,
          screenId: show.screenId,
          sectionId: section.id,
          price: section.basePrice,
        })),
        skipDuplicates: true,
      });

      const seats = await tx.seat.findMany({
        where: {
          screenId: show.screenId,
        },
        select: {
          id: true,
        },
        orderBy: {
          id: "asc",
        },
      });

      await tx.showSeat.createMany({
        data: seats.map((seat, index) => ({
          id: deterministicUuid(
            10_000 + showSequence * 100 + index,
          ),
          showId: show.id,
          screenId: show.screenId,
          seatId: seat.id,
          status: ShowSeatStatus.AVAILABLE,
        })),
        // Never reset existing HELD or BOOKED inventory.
        skipDuplicates: true,
      });
    });
  }
}

async function main() {
  await seedUsers();
  await seedCatalogue();
  await seedShowsAndInventory();

  const [
    movieCount,
    theatreCount,
    screenCount,
    seatCount,
    showCount,
    inventoryCount,
    showPriceCount,
  ] = await Promise.all([
    prisma.movie.count(),
    prisma.theatre.count(),
    prisma.screen.count(),
    prisma.seat.count(),
    prisma.show.count(),
    prisma.showSeat.count(),
    prisma.showSectionPrice.count(),
  ]);

  console.info("Development seed completed:", {
    movieCount,
    theatreCount,
    screenCount,
    seatCount,
    showCount,
    inventoryCount,
    showPriceCount,
  });
}

main()
  .catch((error: unknown) => {
    console.error("Development seed failed:", error);
    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
</file>

