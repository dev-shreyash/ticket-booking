<file path="src/modules/shows/show.validation.ts">
import { z } from "zod";

function isRealCalendarDate(value: string): boolean {
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);

  if (!match) return false;

  const year = Number(match[1]);
  const month = Number(match[2]);
  const day = Number(match[3]);
  const date = new Date(Date.UTC(year, month - 1, day));

  return (
    date.getUTCFullYear() === year &&
    date.getUTCMonth() === month - 1 &&
    date.getUTCDate() === day
  );
}

const isoCalendarDateSchema = z
  .string()
  .refine(isRealCalendarDate, "Date must be a valid YYYY-MM-DD calendar date.");

export const showListQuerySchema = z
  .object({
    movieId: z.string().uuid("Invalid movie ID.").optional(),
    theatreId: z.string().uuid("Invalid theatre ID.").optional(),
    city: z.string().trim().min(1).max(120).optional(),
    date: isoCalendarDateSchema.optional(),
  })
  .strict();

export const showIdSchema = z.string().uuid("Invalid show ID.");

export type ShowListQuery = z.infer<typeof showListQuerySchema>;
</file>

<file path="src/modules/theatres/theatre.repository.ts">
import type { Prisma } from "@/generated/prisma/client";
import { prisma } from "@/lib/prisma";

import type { TheatreListQuery } from "./theatre.validation";

export async function findPublicTheatres(query: TheatreListQuery) {
  const where: Prisma.TheatreWhereInput = {
    screens: { some: {} },
    ...(query.city
      ? {
          city: {
            equals: query.city,
            mode: "insensitive",
          },
        }
      : {}),
  };

  const skip = (query.page - 1) * query.limit;

  const [rows, total] = await Promise.all([
    prisma.theatre.findMany({
      where,
      select: {
        id: true,
        name: true,
        address: true,
        city: true,
        _count: {
          select: { screens: true },
        },
      },
      orderBy: [
        { city: "asc" },
        { name: "asc" },
        { id: "asc" },
      ],
      skip,
      take: query.limit,
    }),
    prisma.theatre.count({ where }),
  ]);

  return {
    data: rows.map(({ _count, ...theatre }) => ({
      ...theatre,
      screenCount: _count.screens,
    })),
    pagination: {
      page: query.page,
      limit: query.limit,
      total,
      totalPages: Math.ceil(total / query.limit),
    },
  };
}

export async function findPublicTheatreById(theatreId: string) {
  const theatre = await prisma.theatre.findFirst({
    where: {
      id: theatreId,
      screens: { some: {} },
    },
    select: {
      id: true,
      name: true,
      address: true,
      city: true,
      screens: {
        select: {
          id: true,
          name: true,
        },
        orderBy: [
          { name: "asc" },
          { id: "asc" },
        ],
      },
    },
  });

  if (!theatre) {
    return null;
  }

  return {
    ...theatre,
    screenCount: theatre.screens.length,
  };
}
</file>

